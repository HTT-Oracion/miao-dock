{
  "name": "miao-dock-installer",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "description": "喵坞安装器程序（独立工程：前端 + src-tauri 宿主持久层）",
  "scripts": {
    "fonts": "node ../scripts/build-install-ui.mjs installer --fonts-only",
    "predev": "npm run fonts",
    "dev": "vite --port 1444 --strictPort",
    "build": "node ../scripts/build-install-ui.mjs installer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.3",
    "sass-embedded": "^1.105.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "喵坞",
  "version": "2.2.1",
  "identifier": "com.miaodock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "喵坞 MiaoDock",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Transparent",
        "backgroundColor": "#FAFAFF"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../../engine/models.manifest.json": "engine/models.manifest.json",
      "../../engine/runtime.manifest.json": "engine/runtime.manifest.json",
      "../../engine/patches.json": "engine/patches.json"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}

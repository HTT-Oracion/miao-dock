    "check:autostart:refute": "node e2e/service-autostart-check.mjs --refute",
    "check:contract": "node e2e/service/contract-delta-check.mjs",
    "check:contract:refute": "node e2e/service/contract-delta-check.mjs --refute",
    "check:engine-settings": "node e2e/service/engine-settings-check.mjs",
    "check:engine-settings:refute": "node e2e/service/engine-settings-check.mjs --refute",
    "fetch:models": "node engine/scripts/fetch-models.mjs",
    "extract:models": "node engine/scripts/fetch-models.mjs --extract",
    "setup:engine": "node engine/scripts/setup-engine.mjs",
    "deps:engine": "node engine/scripts/install-engine-deps.mjs",

{
  "name": "miao-dock",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "description": "喵坞 MiaoDock · Box 桌面端（漫画翻译 + 音乐应用 ver2.0）",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "app": "npm --prefix app run tauri dev",
    "app:build": "npm --prefix app run tauri build",
    "app:build:mac": "npm run task -- sign:preflight && npm --prefix app run tauri build",
    "check": "node e2e/run-checks.mjs --tier static",
    "check:full": "node e2e/run-checks.mjs --tier static,service",
    "check:nightly": "node e2e/run-checks.mjs --tier all",
    "check:changed": "node e2e/run-checks.mjs --tier static,service --changed",
    "selftest": "npm run task -- selftest:engine && npm run task -- selftest:service",
    "test": "npm run check",
    "task": "node e2e/run-script.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}

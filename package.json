{
  "name": "miao-dock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "喵坞 MiaoDock · Box 桌面端（漫画翻译模块 ver1.0）",
  "scripts": {
    "service": "node service/src/server.mjs",
    "engine": "node engine/src/server.mjs",
    "selftest:service": "node service/scripts/selftest.mjs",
    "selftest:engine": "node engine/scripts/selftest.mjs",
    "selftest": "npm run selftest:engine && npm run selftest:service",
    "selftest:app": "node scripts/lifespan-selftest.mjs",
    "selftest:app:refute": "node scripts/lifespan-selftest.mjs --refute",
    "selftest:app:e11": "node scripts/lifespan-selftest.mjs --e11",
    "selftest:app:e11:refute": "node scripts/lifespan-selftest.mjs --e11 --refute",
    "selftest:app:e11:real": "node scripts/lifespan-selftest.mjs --e11 --mode real",
    "check:launch-plan": "node service/scripts/launch-plan-check.mjs",
    "check:child-watch": "node scripts/child-watch-check.mjs",
    "check:child-watch:refute": "node scripts/child-watch-check.mjs --refute",
    "check:engine-client": "node service/scripts/engine-client-check.mjs",
    "check:engine-client:refute": "node service/scripts/engine-client-check.mjs --refute",
    "check:models": "node engine/scripts/model-store-check.mjs",
    "check:models:refute": "node engine/scripts/model-store-check.mjs --refute",
    "fetch:models": "node engine/scripts/fetch-models.mjs",
    "e2e": "node scripts/e2e.mjs",
    "check:tls": "node scripts/tls-check.mjs",
    "check:ia": "node scripts/ia-structure-check.mjs",
    "check:music": "node scripts/music-platform-check.mjs",
    "check:music:refute": "node scripts/music-platform-check.mjs --refute",
    "check:settings": "node scripts/settings-media-check.mjs",
    "check:settings:refute": "node scripts/settings-media-check.mjs --refute",
    "check:units": "node scripts/units-structure-check.mjs",
    "check:units:refute": "node scripts/units-structure-check.mjs --refute",
    "capture": "node scripts/capture.mjs",
    "probe:png": "node scripts/make-probe-png.mjs",
    "app": "npm --prefix app run tauri dev",
    "app:build": "npm --prefix app run tauri build",
    "check:docs": "node scripts/docs-consistency-check.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "name": "miao-dock",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "description": "喵坞 MiaoDock · Box 桌面端（漫画翻译 + 音乐应用 ver2.0）",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build && npm run task -- install:kit",
    "app:build:mac": "npm run task -- sign:preflight && tauri build",
    "check": "node e2e/run-checks.mjs --tier static",
    "check:full": "node e2e/run-checks.mjs --tier static,service",
    "check:nightly": "node e2e/run-checks.mjs --tier all",
    "check:changed": "node e2e/run-checks.mjs --tier static,service --changed",
    "selftest": "npm run task -- selftest:engine && npm run task -- selftest:service",
    "test": "npm run check",
    "task": "node e2e/run-script.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "@radix-ui/react-select": "^2.3.7",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "artplayer": "^5.2.5",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.10"
  }
}

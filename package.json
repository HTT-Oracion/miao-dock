    "check:tls": "node e2e/tls-check.mjs",
    "check:ia": "node e2e/ia-structure-check.mjs",
    "check:music": "node e2e/music-platform-check.mjs",
    "check:music:refute": "node e2e/music-platform-check.mjs --refute",
    "check:settings": "node e2e/settings-media-check.mjs",
    "check:settings:refute": "node e2e/settings-media-check.mjs --refute",
    "check:units": "node e2e/units-structure-check.mjs",
    "check:units:refute": "node e2e/units-structure-check.mjs --refute",
    "capture": "node e2e/capture.mjs",
    "probe:png": "node e2e/make-probe-png.mjs",
    "app": "npm --prefix app run tauri dev",
    "app:build": "npm --prefix app run tauri build",
    "check:docs": "node e2e/docs-consistency-check.mjs",
    "check:bundle": "node e2e/bundle-targets-check.mjs",
    "check:bundle:refute": "node e2e/bundle-targets-check.mjs --refute"
  },
  "engines": {
    "node": ">=20"
  }
}

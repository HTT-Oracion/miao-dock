    "selftest": "npm run selftest:engine && npm run selftest:service",
    "selftest:app": "node e2e/lifespan-selftest.mjs",
    "selftest:app:refute": "node e2e/lifespan-selftest.mjs --refute",
    "selftest:app:e11": "node e2e/lifespan-selftest.mjs --e11",
    "selftest:app:e11:refute": "node e2e/lifespan-selftest.mjs --e11 --refute",
    "selftest:app:e11:real": "node e2e/lifespan-selftest.mjs --e11 --mode real",
    "check:launch-plan": "node e2e/service/launch-plan-check.mjs",
    "check:child-watch": "node e2e/child-watch-check.mjs",
    "check:child-watch:refute": "node e2e/child-watch-check.mjs --refute",
    "check:child-watch-kill": "node e2e/child-watch-kill-check.mjs",
    "check:child-watch-kill:refute": "node e2e/child-watch-kill-check.mjs --refute",
    "check:stdio": "node e2e/child-output-check.mjs",
    "check:stdio:refute": "node e2e/child-output-check.mjs --refute",
    "check:engine-client": "node e2e/service/engine-client-check.mjs",
    "check:engine-client:refute": "node e2e/service/engine-client-check.mjs --refute",
    "check:models": "node e2e/engine/model-store-check.mjs",
    "check:models:refute": "node e2e/engine/model-store-check.mjs --refute",
    "check:engine-patches": "node e2e/engine/engine-patches-check.mjs",
    "check:engine-patches:refute": "node e2e/engine/engine-patches-check.mjs --refute",
    "check:profile": "node e2e/service/engine-profile-check.mjs",
    "check:profile:refute": "node e2e/service/engine-profile-check.mjs --refute",
    "check:e5e6": "node e2e/service/e5-e6-check.mjs",

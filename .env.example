# 喵坞 · 环境变量参考清单
#
# 🔴 **本文件只是清单，不是会被自动加载的配置。**
#    仓库里没有任何 dotenv 加载（Vite 的 `envPrefix` 也只放行 `VITE_` / `TAURI_`），
#    这些变量一律由**进程环境**传入：在启动 `npm run app` / `mangasvc` 的那个终端里
#    `export`/`set`，或写进你的 shell 配置、CI secrets、systemd/docker 的 env。
#    `.env` 已进 `.gitignore` —— 真要用它，请自己在启动前 `source`。
#
# 全部变量名以 `MIAO_` 开头，清单来源：`src-tauri/src/platform/paths.rs`（落点）、
# `src-tauri/src/service/mod.rs`（服务进程）、`engine/scripts/*`（引擎装配）。

# ── 用户侧：落盘位置 ────────────────────────────────────────────────────────
# 作品（漫画）根目录。默认 ~/Pictures/Box 漫画
# MIAO_ROOT=
# 运行期状态目录（任务清单 / 上传暂存 / 令牌）。默认平台应用数据目录下的 Box/state
# MIAO_STATE_DIR=
# 引擎运行时根（python + venv + 模型 + llama.cpp）。默认 <appData>/runtimes/manga-translator
# MIAO_RUNTIME_ROOT=
# 模型根（语义 = 上面那个目录下的模型树）。默认随运行时根
# MIAO_MODEL_ROOT=
# 资产下载通道前缀（留空 = 用清单里的默认 URL；换镜像时填前缀）
# MIAO_ASSET_BASE=
# 模型清单路径（默认内嵌在可执行体里的那一份）
# MIAO_MODEL_MANIFEST=

# ── 用户侧：引擎与服务 ──────────────────────────────────────────────────────
# real（默认，真引擎）| mock（测试替身，不需要引擎运行时）
# MIAO_ENGINE_PROTOCOL=
# 档位：tiny | small | medium | large（默认随设备）
# MIAO_ENGINE_TIER=
# 是否让引擎用 GPU（不设则按档位与设备自动判定）
# MIAO_ENGINE_USE_GPU=
# 服务端口（默认在 5180–5190 里选一个空位）
# MIAO_PORT=
# 引擎侧 python 解释器路径（默认取运行时里的 venv）
# MIAO_ENGINE_PYTHON=

# ── 开发 / 排障 ─────────────────────────────────────────────────────────────
# 指定 mangasvc 可执行体（主窗与 e2e 都读它；缺省按 dev/release 目录找）
# MIAO_MANGASVC_BIN=
# 服务实现选择（D-209 起 Node 实现已退役，填 node 会报错 —— 留作退役门）
# MIAO_SERVICE_IMPL=
# 打印启动配方/落点后退出（`mangasvc --print-launch-plan` / `--print-paths` 的口径）
# MIAO_REPO_ROOT=
# e2e 的临时目录（**代理/沙箱里必须挪到系统临时区**，否则批量删除守卫会拦）
# MIAO_E2E_TMP=

# ── 自检 / 取证通道（默认关）────────────────────────────────────────────────
# 跑一遍应用生命周期自检，打一行 JSON 后退出
# MIAO_SELFTEST=
# 关窗即退进程（**反证开关**：这组断言在此时仍全绿，说明它没测到该测的东西）
# MIAO_CLOSE_QUITS=
# 截图取证目录（依次切屏各截一张；需屏幕解锁）
# MIAO_CAPTURE_DIR=

# ── 打包 / 签名（只在打包机上设）──────────────────────────────────────────
# macOS：公证开关（0 = 放行但不公证，会告警）
# MIAO_NOTARIZE=
# Windows：MSVC / Windows SDK 的非默认安装根（引擎依赖要现场编译 pydensecrf）
# MIAO_VC_ROOT=
# MIAO_SDK_ROOT=

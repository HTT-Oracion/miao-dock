# 依赖与构建产物
node_modules/
dist/
app/src-tauri/target/

# Tauri 生成的 schema / 清单缓存（构建期自动产出，不入库）
app/src-tauri/gen/schemas/

# 本机验收用的临时落盘目录（MIAO_ROOT 覆盖时可能落在仓库内）
tmp-*/

# vite 每次热重启都会把 vite.config.ts 转译到这个时间戳文件里，是纯噪声
vite.config.ts.timestamp-*.mjs

# 系统与编辑器噪声
.DS_Store
*.log

# 生命周期自检的临时落盘根目录
.tmp-selftest/
.tmp-e2e/

# 音乐参考源码（GPL-3.0，开发期只读参考，不入库）
# 移植产物在 app/src-tauri/src/music/，详见 vendor/music-reference/README.md
vendor/

# 编辑器本地历史（VS Code Local History 插件产物，纯本机噪声）
.history/

test-music/